# DIY SystemCore (Raspberry Pi 5 + Waveshare 2-CH CAN FD HAT, Mode A).
# The stock 70-can-interface-names.rules only knows the real SystemCore's SPI
# paths (spi2.0, spi2.1, spi3.0, spi1.0 -> can_s3, spi1.1). Name the HAT's two
# MCP2518FD buses the way the WPILib HAL expects them (a later NAME= wins):
#   HAT CAN_0 = spi0.0 -> can_s0   (CANBus.systemCore(0))
#   HAT CAN_1 = spi1.0 -> can_s1   (CANBus.systemCore(1))
SUBSYSTEM=="net", ACTION=="add", KERNELS=="spi0.0", NAME="can_s0"
SUBSYSTEM=="net", ACTION=="add", KERNELS=="spi1.0", NAME="can_s1"
